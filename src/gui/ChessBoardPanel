package gui;

import board.Board;
import pieces.*;
import utils.Position;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.List;

/**
 * Class that handles the chessboard visuals and the different piece movement methods
 */
public class ChessBoardPanel extends JPanel {

    /** Size of each board square */
    private int squareSize = 80;

    /** The board model */
    private Board board;

    /** Reference to the main GUI frame */
    private ChessGUI gui;

    /** Currently selected square (for click-to-move) */
    private Position selectedPosition = null;

    /** Piece being dragged */
    private Piece draggedPiece = null;

    /** Stores the dragged piece's original square */
    private Position dragFrom = null;

    /** Mouse position while dragging */
    private int dragX, dragY;

    /** Light square color */
    private Color lightColor = new Color(240, 217, 181);

    /** Dark square color */
    private Color darkColor = new Color(181, 136, 99);

    /** Highlight color for selected square */
    private Color selectedColor = new Color(106, 168, 79, 180);

    /** Highlight color for the legal moves' dots */
    private Color legalMoveColor = new Color(0, 0, 0, 60);




    /**
     * Creates the board panel and sets up mouse listeners for the click and drag operations
     * @param board The board model
     * @param gui   The parent GUI frame
     */
    public ChessBoardPanel(Board board, ChessGUI gui) {
        this.board = board;
        this.gui = gui;
        setPreferredSize(new Dimension(squareSize * 8, squareSize * 8));

        MouseAdapter mouseAdapter = new MouseAdapter() {
            @Override
            public void mousePressed(MouseEvent e) {
                int col = e.getX() / squareSize;
                int row = 7 - (e.getY() / squareSize);
                if (!inBounds(row, col)) return;

                Position clicked = new Position(row, col);
                Piece piece = board.getPiece(clicked);

                if (piece != null && piece.getColor().equals(gui.getCurrentTurn())) {
                    // Start drag
                    draggedPiece = piece;
                    dragFrom = clicked;
                    dragX = e.getX();
                    dragY = e.getY();
                    selectedPosition = clicked;
                    repaint();
                }
            }

            @Override
            public void mouseReleased(MouseEvent e) {
                if (draggedPiece != null) {
                    int col = e.getX() / squareSize;
                    int row = 7 - (e.getY() / squareSize);
                    Position to = inBounds(row, col) ? new Position(row, col) : null;

                    if (to != null && !to.equals(dragFrom)) {
                        gui.attemptMove(dragFrom, to);
                    }

                    draggedPiece = null;
                    dragFrom = null;
                    selectedPosition = null;
                    repaint();
                }
            }

            @Override
            public void mouseClicked(MouseEvent e) {
                if (draggedPiece != null) return; // handled by drag

                int col = e.getX() / squareSize;
                int row = 7 - (e.getY() / squareSize);
                if (!inBounds(row, col)) return;

                Position clicked = new Position(row, col);

                if (selectedPosition == null) {
                    // Select a piece
                    Piece piece = board.getPiece(clicked);
                    if (piece != null && piece.getColor().equals(gui.getCurrentTurn())) {
                        selectedPosition = clicked;
                        repaint();
                    }
                } else {
                    // Move to destination
                    if (!clicked.equals(selectedPosition)) {
                        gui.attemptMove(selectedPosition, clicked);
                    }
                    selectedPosition = null;
                    repaint();
                }
            }
        };

        MouseMotionAdapter motionAdapter = new MouseMotionAdapter() {
            @Override
            public void mouseDragged(MouseEvent e) {
                if (draggedPiece != null) {
                    dragX = e.getX();
                    dragY = e.getY();
                    repaint();
                }
            }
        };

        addMouseListener(mouseAdapter);
        addMouseMotionListener(motionAdapter);
    }




    /**
     * Paints the board, pieces, highlights, and drag ghost
     * @param g The Graphics context
     */
    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        g2.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING, RenderingHints.VALUE_TEXT_ANTIALIAS_ON);

        drawSquares(g2);
        drawCoordinates(g2);
        drawHighlights(g2);
        drawPieces(g2);
        drawDraggedPiece(g2);
    }


    /**
     * Draws alternating light and dark board squares
     */
    private void drawSquares(Graphics2D g2) {
        for (int row = 0; row < 8; row++) {
            for (int col = 0; col < 8; col++) {
                boolean light = (row + col) % 2 == 0;
                g2.setColor(light ? lightColor : darkColor);
                g2.fillRect(col * squareSize, (7 - row) * squareSize, squareSize, squareSize);
            }
        }
    }


    /**
     * Draws rank and file coordinate labels around the board
     */
    private void drawCoordinates(Graphics2D g2) {
        g2.setFont(new Font("Georgia", Font.BOLD, 11));
        for (int i = 0; i < 8; i++) {
            // Files (A-H) at bottom
            boolean lightSquare = i % 2 == 0;
            g2.setColor(lightSquare ? darkColor : lightColor);
            g2.drawString(String.valueOf((char)('A' + i)), i * squareSize + 4, squareSize * 8 - 4);
            // Ranks (1-8) at left
            lightSquare = i % 2 != 0;
            g2.setColor(lightSquare ? darkColor : lightColor);
            g2.drawString(String.valueOf(i + 1), 4, (7 - i) * squareSize + 14);
        }
    }


    /**
     * Draws selection highlight and legal move indicators
     */
    private void drawHighlights(Graphics2D g2) {
        if (selectedPosition != null) {
            int col = selectedPosition.getCol();
            int row = selectedPosition.getRow();
            g2.setColor(selectedColor);
            g2.fillRect(col * squareSize, (7 - row) * squareSize, squareSize, squareSize);

            // Draw legal move dots
            Piece piece = board.getPiece(selectedPosition);
            if (piece != null) {
                List<Position> moves = piece.possibleMoves(board);
                for (Position move : moves) {
                    int mc = move.getCol();
                    int mr = move.getRow();
                    Piece target = board.getPiece(move);
                    if (target != null) {
                        // Ring around capture square
                        g2.setColor(new Color(0, 0, 0, 80));
                        g2.setStroke(new BasicStroke(4));
                        g2.drawOval(mc * squareSize + 4, (7 - mr) * squareSize + 4,
                                squareSize - 8, squareSize - 8);
                    } else {
                        // Dot for empty square
                        g2.setColor(legalMoveColor);
                        int dotSize = squareSize / 3;
                        g2.fillOval(mc * squareSize + squareSize / 2 - dotSize / 2,
                                (7 - mr) * squareSize + squareSize / 2 - dotSize / 2,
                                dotSize, dotSize);
                    }
                }
            }
        }

        // Highlight king in check
        String turn = gui.getCurrentTurn();
        if (board.isCheck(turn)) {
            Position kingPos = findKingPos(turn);
            if (kingPos != null) {
                g2.setColor(new Color(255, 0, 0, 120));
                g2.fillRect(kingPos.getCol() * squareSize,
                        (7 - kingPos.getRow()) * squareSize, squareSize, squareSize);
            }
        }
    }


    /**
     * Draws all pieces on the board, skipping the one being dragged
     */
    private void drawPieces(Graphics2D g2) {
        for (int row = 0; row < 8; row++) {
            for (int col = 0; col < 8; col++) {
                Position pos = new Position(row, col);
                Piece piece = board.getPiece(pos);
                if (piece == null) continue;
                if (piece == draggedPiece) continue; // Drawn separately

                int x = col * squareSize;
                int y = (7 - row) * squareSize;
                drawPiece(g2, piece, x, y, squareSize);
            }
        }
    }


    /**
     * Draws the piece currently being dragged at the mouse cursor position
     */
    private void drawDraggedPiece(Graphics2D g2) {
        if (draggedPiece != null) {
            int x = dragX - squareSize / 2;
            int y = dragY - squareSize / 2;
            drawPiece(g2, draggedPiece, x, y, squareSize);
        }
    }


    /**
     * Draws a single piece as a Unicode chess symbol with a shadow for readability
     * @param g2     Graphics context
     * @param piece  The piece to draw
     * @param x      Pixel x
     * @param y      Pixel y
     * @param size   Square size
     */
    private void drawPiece(Graphics2D g2, Piece piece, int x, int y, int size) {
        String symbol = getUnicodeSymbol(piece);
        Font font = new Font("Segoe UI Symbol", Font.PLAIN, (int)(size * 0.72));
        g2.setFont(font);

        FontMetrics fm = g2.getFontMetrics();
        int sx = x + (size - fm.stringWidth(symbol)) / 2;
        int sy = y + (size + fm.getAscent() - fm.getDescent()) / 2 - 2;

        // Shadow
        g2.setColor(new Color(0, 0, 0, 60));
        g2.drawString(symbol, sx + 2, sy + 2);

        // Piece color
        g2.setColor(piece.getColor().equals("white") ? new Color(255, 255, 255) : new Color(30, 30, 30));
        g2.drawString(symbol, sx, sy);

        // Outline for white pieces so they're visible on light squares
        if (piece.getColor().equals("white")) {
            g2.setColor(new Color(80, 80, 80, 140));
            g2.setFont(font.deriveFont(Font.PLAIN));
        }
    }


    /**
     * Returns the Unicode chess symbol for a piece
     * @param piece The piece
     * @return Unicode string
     */
    private String getUnicodeSymbol(Piece piece) {
        boolean white = piece.getColor().equals("white");
        if (piece instanceof King)   return white ? "♔" : "♚";
        if (piece instanceof Queen)  return white ? "♕" : "♛";
        if (piece instanceof Rook)   return white ? "♖" : "♜";
        if (piece instanceof Bishop) return white ? "♗" : "♝";
        if (piece instanceof Knight) return white ? "♘" : "♞";
        if (piece instanceof Pawn)   return white ? "♙" : "♟";
        return "?";
    }


    /**
     * Finds the king's position for a given color
     * @param color Team color
     * @return King's position or null
     */
    private Position findKingPos(String color) {
        for (int row = 0; row < 8; row++) {
            for (int col = 0; col < 8; col++) {
                Piece p = board.getPiece(new Position(row, col));
                if (p instanceof King && p.getColor().equals(color)) {
                    return new Position(row, col);
                }
            }
        }
        return null;
    }


    /**
     * Checks if a row/col is within the 8x8 board
     */
    private boolean inBounds(int row, int col) {
        return row >= 0 && row < 8 && col >= 0 && col < 8;
    }


    /**
     * Updates the board reference and repaints
     * @param board The new board
     */
    public void setBoard(Board board) {
        this.board = board;
        repaint();
    }


    /**
     * Sets the square size and resizes the panel
     * @param size New square size in pixels
     */
    public void setSquareSize(int size) {
        this.squareSize = size;
        setPreferredSize(new Dimension(size * 8, size * 8));
        revalidate();
        repaint();
    }


    /** @return Current square size */
    public int getSquareSize() { return squareSize; }


    /**
     * Sets the light square color
     * @param c New color
     */
    public void setLightColor(Color c) { this.lightColor = c; repaint(); }


    /**
     * Sets the dark square color
     * @param c New color
     */
    public void setDarkColor(Color c) { this.darkColor = c; repaint(); }


    /** Clears any selection state */
    public void clearSelection() {
        selectedPosition = null;
        draggedPiece = null;
        dragFrom = null;
        repaint();
    }
}
